{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "medication-cd9b8",
          "appId": "1:173965270100:android:15d9c9f46979c0b6c8e1c1",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "medication-cd9b8",
          "appId": "1:173965270100:ios:e04ad7a89364b20fc8e1c1",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "medication-cd9b8",
          "appId": "1:173965270100:ios:bc0f09e9bf64e849c8e1c1",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "medication-cd9b8",
          "configurations": {
            "macos": "1:173965270100:ios:e04ad7a89364b20fc8e1c1"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run lint"],
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "main",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "http://dawatime.com{,/**}",
          "destination": "https://dawatime.com",
          "type": 301
        },
        {
          "source": "https://www.dawatime.com{,/**}",
          "destination": "https://dawatime.com",
          "type": 301
        },
        {
          "source": "/account-deletion.html",
          "destination": "/account-deletion",
          "type": 301
        },
        {
          "source": "/user-management.html",
          "destination": "/user-management",
          "type": 301
        },
        {
          "source": "/support.html",
          "destination": "/support",
          "type": 301
        },
        {
          "source": "/privacy-policy.html",
          "destination": "/privacy-policy",
          "type": 301
        },
        {
          "source": "/terms-and-conditions.html",
          "destination": "/terms-and-conditions",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/account-deletion",
          "destination": "/account-deletion.html"
        },
        {
          "source": "/user-management",
          "destination": "/user-management.html"
        },
        { "source": "/support", "destination": "/support.html" },
        { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
        {
          "source": "/terms-and-conditions",
          "destination": "/terms-and-conditions.html"
        },
        { "source": "/", "destination": "/index.html" }
      ]
    },
    {
      "target": "webapp",
      "public": "build/web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
